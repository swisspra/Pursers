{
  "$schema": "vendor/aion-hub-extension-schema-v0.json",
  "name": "pursers",
  "displayName": "Pursers",
  "version": "0.1.0",
  "description": "Guided Pursers project setup, Team controls, recovery, and worker/reviewer presets.",
  "author": "Pursers",
  "engine": {
    "aionui": "^2.2.1"
  },
  "permissions": {
    "storage": true,
    "network": {
      "allowedDomains": [
        "127.0.0.1",
        "localhost",
        "::1"
      ],
      "reasoning": "Register the local Pursers wait bridge with the AionUi API."
    }
  },
  "risk": {
    "level": "moderate",
    "reasoning": "The extension uses persistent storage and loopback-only network access."
  },
  "contributes": {
    "assistants": [
      {
        "id": "pursers-worker-codex",
        "name": "Pursers Worker (Codex)",
        "description": "A Pursers worker seat using Codex.",
        "agentId": "codex",
        "presetAgentType": "codex",
        "contextFile": "contexts/worker.md"
      },
      {
        "id": "pursers-worker-claude",
        "name": "Pursers Worker (Claude)",
        "description": "A Pursers worker seat using Claude.",
        "agentId": "claude",
        "presetAgentType": "claude",
        "contextFile": "contexts/worker.md"
      },
      {
        "id": "pursers-reviewer-codex",
        "name": "Pursers Reviewer (Codex)",
        "description": "A Pursers reviewer seat using Codex.",
        "agentId": "codex",
        "presetAgentType": "codex",
        "contextFile": "contexts/reviewer.md"
      },
      {
        "id": "pursers-reviewer-claude",
        "name": "Pursers Reviewer (Claude)",
        "description": "A Pursers reviewer seat using Claude.",
        "agentId": "claude",
        "presetAgentType": "claude",
        "contextFile": "contexts/reviewer.md"
      }
    ],
    "settingsTabs": [
      {
        "id": "pursers",
        "name": "Pursers",
        "entryPoint": "webui/index.html",
        "position": {
          "anchor": "tools",
          "placement": "after"
        },
        "order": 80
      }
    ],
    "webui": [
      {
        "id": "pursers-home",
        "directory": "webui",
        "routes": [
        {
          "path": "/pursers/join",
          "method": "POST",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/status",
          "method": "GET",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/onboarding/validate",
          "method": "POST",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/onboarding/connect",
          "method": "POST",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/onboarding/status",
          "method": "GET",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/onboarding/rotate",
          "method": "POST",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/onboarding/recover",
          "method": "POST",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/team/status",
          "method": "GET",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/team/plan",
          "method": "POST",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/team/apply",
          "method": "POST",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/team/seat/pause",
          "method": "POST",
          "handler": "webui/routes.js"
        },
        {
          "path": "/pursers/team/seat/stop",
          "method": "POST",
          "handler": "webui/routes.js"
        }
        ]
      }
    ]
  }
}
