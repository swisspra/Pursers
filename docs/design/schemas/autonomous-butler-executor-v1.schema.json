{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pursers.invalid/schemas/autonomous-butler-executor-v1.schema.json",
  "title": "Autonomous Butler host executor envelope v1",
  "oneOf": [
    {"$ref": "#/$defs/request"},
    {"$ref": "#/$defs/result"}
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "message_type", "operation_id", "board_id", "action", "seat_id", "template_id", "template_digest_sha256", "expected_seat_generation", "authorization_fingerprint_sha256", "deadline"],
      "properties": {
        "schema": {"const": "autonomous_butler_executor_v1"},
        "schema_version": {"const": 1},
        "message_type": {"const": "request"},
        "operation_id": {"$ref": "#/$defs/id"},
        "board_id": {"$ref": "#/$defs/id"},
        "action": {"enum": ["inspect", "start", "drain", "stop"]},
        "seat_id": {"$ref": "#/$defs/id"},
        "template_id": {"$ref": "#/$defs/id"},
        "template_digest_sha256": {"$ref": "#/$defs/sha256"},
        "expected_seat_generation": {"type": "integer", "minimum": 1},
        "authorization_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "deadline": {"type": "string", "format": "date-time"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "message_type", "operation_id", "board_id", "outcome", "committed", "observed_at"],
      "properties": {
        "schema": {"const": "autonomous_butler_executor_v1"},
        "schema_version": {"const": 1},
        "message_type": {"const": "result"},
        "operation_id": {"$ref": "#/$defs/id"},
        "board_id": {"$ref": "#/$defs/id"},
        "outcome": {"enum": ["succeeded", "rejected", "failed", "cancelled", "unknown"]},
        "committed": {"type": "boolean"},
        "observed_at": {"type": "string", "format": "date-time"},
        "reason_code": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$"},
        "process_ref": {"$ref": "#/$defs/id"},
        "checkout_ref": {"$ref": "#/$defs/id"}
      }
    }
  }
}
